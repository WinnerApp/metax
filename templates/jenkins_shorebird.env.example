# Jenkins / CI：Shorebird + Meta Code Push
# 放到 jenkins_ci/env/build_app/common/.env 或对应 job 环境变量

# Shorebird CLI 构建鉴权（Console API Key）
SHOREBIRD_TOKEN=

# CLI 构建登记：metax 会强制 https://api.shorebird.dev（忽略本变量/误配的 OTA 地址）
# 设备 OTA 仍看 shorebird.yaml base_url / META_OTA_API
# SHOREBIRD_HOSTED_URL=https://api.shorebird.dev
# Flutter 引擎下载：metax 会强制 https://download.shorebird.dev
# FLUTTER_STORAGE_BASE_URL=https://download.shorebird.dev

# 可选覆盖：true/false；日常以 metaapp_flutter/pubspec.yaml 的 metax.shorebird_enabled 为准
# SHOREBIRD_ENABLED=true

# Meta Code Push（补丁推送）
META_OTA_API=http://119.23.47.1:9527/
META_OTA_TOKEN=
# 可选，默认读 shorebird.yaml app_id
# META_OTA_APP_ID=
# META_OTA_ARCH=aarch64
# META_OTA_CHANNEL=stable

# patch 门禁基线（也可 metax patch --base-commit）
# META_OTA_BASE_COMMIT=
# SHOREBIRD_BASE_COMMIT=
