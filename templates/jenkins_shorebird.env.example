# Jenkins / CI：Shorebird + Meta Code Push
# 放到 jenkins_ci/env/build_app/common/.env 或对应 job 环境变量

# meta_app 工程根（含 metaapp_flutter/）；热更脚本优先读 APP_DIR，勿依赖 Jenkins WORKSPACE
# APP_DIR=/path/to/meta_app

# 出包前预检（建议 Jenkins 先跑，失败即停，避免末尾才报错）:
#   metax init doctor
#   metax init doctor --unity --shorebird --patch --upload
#   metax init shorebird          # 仅 Shorebird 细查
#   metax init shorebird --patch

# FlutterPatch CLI 鉴权
FLUTTERPATCH_TOKEN=
# 可选：CLI 绝对路径（默认 PATH 中的 flutterpatch）
# FLUTTERPATCH_BIN=/Users/xxx/.flutterpatch/bin/flutterpatch

# 控制面只读 shorebird.yaml base_url；不要设 SHOREBIRD_HOSTED_URL（metax 出包会移除）
# Flutter 引擎下载：metax 会强制 https://download.shorebird.dev
# FLUTTER_STORAGE_BASE_URL=https://download.shorebird.dev

# 可选覆盖：true/false；日常以 metaapp_flutter/pubspec.yaml 的 metax.shorebird_enabled 为准
# SHOREBIRD_ENABLED=true

# 热更预审会读 Appwrite 打包记录（各 submodule + Unity 的 commit），
# 需与平时 metax upload 相同的 APPWRITE_BUILD_* / APPWRITE_* 环境。
# 强行跳过预审：metax patch ... --force-patch

# Meta Code Push（metax 委托外部 meta_ota；鉴权用本机 meta_ota config，不传 --api/--token、不注入 TOKEN）
# 本地先: meta_ota config --api <URL> --token <API Key>
# - Shorebird 打包完成后：
#     meta_ota admin upload-release（登记 release）
#     → meta_ota upload-snapshot（OTA 快照）
#     → meta_ota upload-resources（资源配置基线）
# - 补丁：
#     meta_ota upload（Dart 补丁）
#     → meta_ota upload-resource-pack（有变动的资源包）
# META_OTA_API / META_OTA_TOKEN 可选（CI 若未 meta_ota config 时可设）；日常靠 ~/.meta_ota
# META_OTA_API=http://119.23.47.1:9527/
# META_OTA_TOKEN=
# 可选，默认读 shorebird.yaml app_id（upload-release / 基线 / 资源包必需）
# META_OTA_APP_ID=
# META_OTA_ARCH=aarch64
# META_OTA_CHANNEL=stable
# 跳过打包后的 release 登记（连带跳过 snapshot/resources）：META_OTA_SKIP_RELEASE_SYNC=true
# 仅跳过 snapshot + resources：META_OTA_SKIP_BASELINE_SYNC=true
# 跳过热更后的资源包：META_OTA_SKIP_RESOURCE_PACK=true
# 可选上传 release 产物：META_OTA_RELEASE_ARTIFACT=/path/to/file
# meta_ota 可执行文件：PATH 中的 meta_ota，或显式路径 / 仓库根
# META_OTA_BIN=/path/to/meta_ota
# META_CODE_PUSH_ROOT=/path/to/flutterpatch
